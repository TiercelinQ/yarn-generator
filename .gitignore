!.yarn/versions
.pnp.*

# Local work plan
tasks/

# Project runtime data - never commit env, logs, or exports
.env
logs/
*.log
exports/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
